{
  "name": "@winlerr/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared build and runtime configuration for Winlerr",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./eslint": "./eslint-preset.mjs",
    "./typescript": "./typescript.json"
  },
  "files": ["eslint-preset.mjs", "typescript.json", "src"],
  "scripts": {
    "lint": "eslint . || exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
