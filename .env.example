# Winlerr — environment template (NO SECRETS HERE)
#
# Copy to `.env` (root) or `apps/web/.env.local` and fill in real values.
# `.env` is gitignored — never commit real credentials.
# Every value below is intentionally empty.

# --- App ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# --- Supabase (Project Settings → API in the Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to clients, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (OpenRouter powers /api/concierge and /api/demo-reply) ---
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
AI_FALLBACK_MODEL=

# --- Email (Resend, used by the claim flow) ---
RESEND_API_KEY=
OWNER_EMAIL=
